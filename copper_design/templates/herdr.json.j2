{#-
  A herdr terminal theme; tests/test_herdr.py says what herdr reads and holds
  the rendered file to it.

  The terminal is a surface (a pane on the canvas), so its background is
  `surface`, and herdr's canvas and chrome are `bg` and `bg-alt`. ANSI order:
  black, red, green, yellow, blue, magenta (violet), cyan (teal), white, then
  the bright eight.

  The colours reach 3:1 on the terminal background, and each bright colour is
  lighter than its normal one. Dark mode takes the solid steps (9) and, for the
  bright ones, the text steps (11); yellow and teal lift their solid steps
  above step 11, so their bright colours take the lifted step 10. Light mode
  takes the text steps (11) and, for the bright ones, the hovered solid steps
  (10); yellow's solid steps are too light for 3:1, so yellow takes its text
  steps (12, then 11), and blue's step 10 is darker than its step 11, so
  bright blue takes step 9.

  As in the common schemes, the grey on the background's side is a fill close
  to the background, behind the colours (a status bar's black on green): black
  in dark mode, white in light mode. Its bright twin and the greys on the far
  side are text steps that stay readable on the background.
-#}
{%- if mode == "light" -%}
{%- set ansi = [
  "neutral-12", "red-11", "green-11", "yellow-12", "blue-11", "violet-11", "teal-11", "neutral-3",
  "neutral-11", "red-10", "green-10", "yellow-11", "blue-9", "violet-10", "teal-10", "neutral-9",
] -%}
{%- else -%}
{%- set ansi = [
  "neutral-6", "red-9", "green-9", "yellow-9", "blue-9", "violet-9", "teal-9", "neutral-11",
  "neutral-9", "red-11", "green-11", "yellow-10", "blue-11", "violet-11", "teal-10", "neutral-12",
] -%}
{%- endif -%}
{%- set panel = [
  ("foreground", "text"),
  ("surface", "surface"),
  ("canvas", "bg"),
  ("chrome", "bg-alt"),
  ("popover", "surface"),
  ("raised", "surface-raised"),
  ("hover", "neutral-4"),
  ("selected", "selection"),
  ("border", "border"),
  ("input", "border-strong"),
  ("muted", "text-muted"),
  ("dim", "text-subtle"),
  ("accent", "accent"),
  ("accent_foreground", "on-accent"),
  ("solid", "text"),
  ("solid_foreground", "surface"),
  ("ring", "accent"),
  ("working", "warning"),
  ("blocked", "error"),
  ("done", "success"),
  ("idle", "text-subtle"),
  ("unknown", "text-subtle"),
] -%}
{
  "background": {{ c["surface"] | tojson }},
  "foreground": {{ c["text"] | tojson }},
  "selection": {{ c["selection"] | tojson }},
  "cursor": {{ c["text"] | tojson }},
  "ansi": [
{%- for name in ansi %}
    {{ c[name] | tojson }}{{ "," if not loop.last }}
{%- endfor %}
  ],
  "colors": {
{%- for key, name in panel %}
    {{ key | tojson }}: {{ c[name] | tojson }}{{ "," if not loop.last }}
{%- endfor %}
  }
}
