{#-
  The Android port's named colours and roles as Compose colours, for both
  modes: one type, one instance per mode, so an app picks the mode at run time.
  The colours are properties overridden in one object per mode, not constructor
  parameters: a JVM method takes at most 255 parameter slots and a Compose
  colour takes two, so a constructor would stop compiling at about 127 colours. The
  companion's getters return the objects when called, so no static initialiser
  of this class reads an object that is still being initialised.
  tests/test_android.py holds the rendered file to the tokens.
-#}
{%- set light = modes[0] -%}
// Generated by copper-design from its tokens; do not edit.

package dev.cupr.design

import androidx.compose.runtime.Immutable
import androidx.compose.ui.graphics.Color

/**
 * copper's colours in one mode: every named colour (a base colour's main value, its step 9, and its
 * steps 1-12) and every role. [light] and [dark] are the two modes.
 */
@Immutable
sealed class CopperColors {
{%- for name in light.bases %}
    abstract val {{ name | kotlin_name }}: Color
{%- for step in range(1, 13) %}
    abstract val {{ (name ~ '-' ~ step) | kotlin_name }}: Color
{%- endfor %}
{%- endfor %}
{%- for role in light.roles %}
    abstract val {{ role | kotlin_name }}: Color
{%- endfor %}
{%- for m in modes %}

    private object {{ m.mode | capitalize }} : CopperColors() {
{%- for name in m.bases %}
        override val {{ name | kotlin_name }} = {{ m.c[name] | kotlin_colour }}
{%- for step in range(1, 13) %}
        override val {{ (name ~ '-' ~ step) | kotlin_name }} = {{ m.c[name ~ '-' ~ step] | kotlin_colour }}
{%- endfor %}
{%- endfor %}
{%- for role in m.roles %}
        override val {{ role | kotlin_name }} = {{ m.c[role] | kotlin_colour }}
{%- endfor %}
    }
{%- endfor %}

    companion object {
{%- for m in modes %}
        /** copper's {{ m.mode }} mode. */
        val {{ m.mode }}: CopperColors get() = {{ m.mode | capitalize }}
{%- if not loop.last %}
{% endif %}
{%- endfor %}
    }
}
