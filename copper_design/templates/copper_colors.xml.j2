{#-
  The Android port's colour resources for one mode: values/ for light mode,
  values-night/ for dark mode, so the system picks the mode. Every named colour
  and every role, prefixed copper_ since resource names are global in an app.
  tests/test_android.py holds the rendered file to the tokens.
-#}
<?xml version="1.0" encoding="utf-8"?>
<!-- copper's colours in {{ mode }} mode. Generated by copper-design from its tokens; do not edit. -->
<resources>
{%- for name in bases %}
    <!-- {{ name }}: its main value (step 9) and its steps 1-12 -->
    <color name="{{ name | android_name }}">{{ c[name] | android_colour }}</color>
{%- for step in range(1, 13) %}
    <color name="{{ (name ~ '-' ~ step) | android_name }}">{{ c[name ~ '-' ~ step] | android_colour }}</color>
{%- endfor %}
{%- endfor %}
    <!-- The roles -->
{%- for role in roles %}
    <color name="{{ role | android_name }}">{{ c[role] | android_colour }}</color>
{%- endfor %}
</resources>
