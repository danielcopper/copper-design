<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>copper preview</title>
<style>
  body { margin: 0; font: 14px/1.4 system-ui, sans-serif; }
  section { padding: 24px 32px 40px; }
  h1 { margin: 0 0 4px; font-size: 22px; }
  h2 { margin: 28px 0 10px; font-size: 16px; }
  p.note { margin: 0 0 8px; }
  table { border-collapse: collapse; }
  td, th { padding: 4px 8px; text-align: left; vertical-align: middle; }
  th { font-weight: 600; }
  .mono { font-family: ui-monospace, monospace; font-size: 12px; }
  .chip { display: inline-block; width: 64px; height: 36px; border-radius: 6px; }
  .step { width: 64px; height: 44px; border-radius: 6px; display: flex; align-items: flex-end; justify-content: center;
          font: 10px ui-monospace, monospace; padding-bottom: 3px; box-sizing: border-box; }
  .fail { font-weight: 700; }
  .term { border-radius: 10px; padding: 14px 18px; font: 13px/1.6 ui-monospace, monospace; }
  .card { border-radius: 10px; padding: 16px; display: inline-block; margin-right: 12px; }
  .button { border-radius: 6px; padding: 6px 14px; display: inline-block; }
</style>
</head>
<body>
{%- for m in modes %}
{%- set c = m.c %}
<section style="background: {{ c['bg'] }}; color: {{ c['text'] }};">
  <h1>copper, {{ m.mode }} mode</h1>
  <p class="note" style="color: {{ c['text-muted'] }}">Palette, roles, their contrast, colour-blindness views and the herdr theme.</p>

  <h2>Palette</h2>
  <table>
    <tr><th></th>{% for step in range(1, 13) %}<th class="mono">{{ step }}</th>{% endfor %}</tr>
    {%- for name in m.bases %}
    <tr>
      <th>{{ name }}</th>
      {%- for hex, label in m.scales[name] %}
      <td><div class="step" style="background: {{ hex }}; color: {{ label }}">{{ hex }}</div></td>
      {%- endfor %}
    </tr>
    {%- endfor %}
  </table>

  <h2>Roles</h2>
  <table>
    <tr><th>role</th><th></th><th>step</th><th>hex</th>{% for b in backdrops %}<th>on {{ b }}</th>{% endfor %}<th>needs</th></tr>
    {%- for row in m.roles %}
    <tr>
      <td class="mono">{{ row.name }}</td>
      <td><span class="chip" style="background: {{ row.hex }}; outline: 1px solid {{ c['border'] }}"></span></td>
      <td class="mono">{{ row.reference }}</td>
      <td class="mono">{{ row.hex }}</td>
      {%- for ratio in row.ratios %}
      <td class="mono{{ ' fail' if row.need and ratio < row.need }}">{{ '%.2f' % ratio }}</td>
      {%- endfor %}
      <td class="mono">{{ row.need ~ ':1' if row.need else '' }}{{ ' (fails)' if not row.passes }}</td>
    </tr>
    {%- endfor %}
  </table>
  <p class="note mono">on-accent on accent: {{ '%.2f' % m.on_accent }}:1 (needs 4.5:1)</p>

  <h2>In use</h2>
  <div class="card" style="background: {{ c['surface'] }}; border: 1px solid {{ c['border'] }}">
    <div style="color: {{ c['text'] }}; font-weight: 600">A card on bg</div>
    <div style="color: {{ c['text-muted'] }}">Muted text on surface</div>
    <div style="color: {{ c['text-subtle'] }}">Subtle text on surface</div>
    <div style="margin-top: 10px; background: {{ c['surface-raised'] }}; border-radius: 6px; padding: 6px 10px">surface-raised</div>
    <div style="margin-top: 10px"><span class="button" style="background: {{ c['accent'] }}; color: {{ c['on-accent'] }}">Accent</span>
      <span style="background: {{ c['selection'] }}; padding: 2px 4px">selected text</span></div>
    <div style="margin-top: 10px">
      {%- for state in ['success', 'warning', 'error', 'info'] %}
      <span style="color: {{ c[state] }}; margin-right: 10px">&#9679; {{ state }}</span>
      {%- endfor %}
    </div>
  </div>
  <div class="card" style="background: {{ c['bg-alt'] }}">
    <div style="color: {{ c['text'] }}">bg-alt</div>
  </div>

  <h2>Colour-blindness views</h2>
  <table>
    <tr><th></th>{% for name in m.cvd.names %}<th class="mono">{{ name }}</th>{% endfor %}</tr>
    {%- for kind, hexes in m.cvd.rows %}
    <tr><th>{{ kind }}</th>{% for hex in hexes %}<td><span class="chip" style="background: {{ hex }}"></span></td>{% endfor %}</tr>
    {%- endfor %}
  </table>

  <h2>herdr theme</h2>
  {%- set h = m.herdr %}
  <div class="term" style="background: {{ h.background }}; color: {{ h.foreground }}; border: 1px solid {{ h.colors.border }}">
    <div>$ ls --color <span style="background: {{ h.selection }}">selected</span><span style="background: {{ h.cursor }}">&nbsp;</span></div>
    {%- for start in [0, 8] %}
    <div>
      {%- for hex, ratio in m.ansi[start:start + 8] %}
      <span style="color: {{ hex }}; margin-right: 14px">ansi{{ start + loop.index0 }} {{ '%.1f' % ratio }}</span>
      {%- endfor %}
    </div>
    {%- endfor %}
  </div>
  <table style="margin-top: 10px">
    {%- for key, hex in h.colors.items() %}
    <tr><td class="mono">{{ key }}</td><td><span class="chip" style="background: {{ hex }}; height: 18px; outline: 1px solid {{ c['border'] }}"></span></td><td class="mono">{{ hex }}</td></tr>
    {%- endfor %}
  </table>
</section>
{%- endfor %}
</body>
</html>
